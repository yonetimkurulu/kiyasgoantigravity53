{
    "builds": [
        {
            "src": "backend/app/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "package.json",
            "use": "@vercel/next"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/metrics",
            "schedule": "20 3 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/v1/:path*",
            "destination": "backend/app/main.py"
        }
    ]
}