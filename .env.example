# Database Connection
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Security for Scraper Webhook
SCRAPER_SECRET_KEY="super_secret_key_change_me"

# Google Gemini API for AI Features
GEMINI_API_KEY="your_gemini_api_key"

# --- MVP AI (recommended) ---
# Keep AI_PROVIDER=openai for stable default behavior.
AI_PROVIDER="openai"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"
AI_REQUEST_TIMEOUT_MS="15000"

# Optional: only when using your own hosted LLM API
# AI_PROVIDER="custom"
# CUSTOM_LLM_API_URL="https://your-llm-host.example.com/v1/chat/completions"
# CUSTOM_LLM_API_KEY="optional_bearer_token"
# CUSTOM_LLM_MODEL="your-model-name"
