# KıyasGO AI Backend Config
# BU DOSYANIN ADINI .env OLARAK DEĞİŞTİRİP ANAHTARLARI GİRİN

PROJECT_NAME="KiyasGO AI"
API_V1_STR="/api/v1"

# Supabase Ayarları (Proje Settings -> API kısmından al)
SUPABASE_URL="https://your-project-id.supabase.co"
# Server-side işlemler için 'service_role' key gerekli (yazma yetkisi)
SUPABASE_KEY="your-service-role-key-here"

# AI Motoru (RAG için gerekli)
OPENAI_API_KEY="sk-..."

# YouTube Veri Çekme (Opsiyonel)
YOUTUBE_API_KEY="AIza..."
